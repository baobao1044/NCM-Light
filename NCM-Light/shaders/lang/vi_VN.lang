profile.POTATO=iGPU Máy Yếu (FPS Tối Đa)
profile.BALANCED=Cân Bằng (Khuyên Dùng)
profile.ULTRA=Siêu Nét (High Detail)

option.DEBUG_LEVEL=Chế độ xem thử
value.DEBUG_LEVEL.0=Ảnh cuối
value.DEBUG_LEVEL.1=Chỉ cấp thô nhất (1/4 res)
value.DEBUG_LEVEL.2=Bản đồ nhiệt residual / khối lượng tính
value.DEBUG_LEVEL.3=Chỉ ánh sáng thể tích
value.DEBUG_LEVEL.4=Bản đồ độ sâu & lớp
value.DEBUG_LEVEL.5=Màu sương & tia nắng
value.DEBUG_LEVEL.6=Chỉ Ray Tracing (RTGI + RTAO + Phản chiếu)

option.SHADOWS=Bóng đổ
value.SHADOWS.0=Tắt (tia màn hình nhẹ)
value.SHADOWS.1=Bật (shadow map nén 4.4x)

option.RT_GI=Ray Tracing GI & AO (NCM)
value.RT_GI.0=Tắt
value.RT_GI.1=Bật (bán cầu 1/4 res)

option.RT_REFLECTIONS=Phản chiếu Ray Tracing (NCM)
value.RT_REFLECTIONS.0=Tắt
value.RT_REFLECTIONS.1=Bật (nước, kính, kim loại & mưa)

option.VOLUMETRIC_CLOUDS=Mây thể tích NCM
value.VOLUMETRIC_CLOUDS.0=Tắt (trời quang + cực quang)
value.VOLUMETRIC_CLOUDS.1=Bật (mây cumulus đa cấp)

option.WAVING_FOLIAGE=Cỏ & lá cây đung đưa
value.WAVING_FOLIAGE.0=Tắt
value.WAVING_FOLIAGE.1=Bật (gió thổi cả bóng đổ)

option.COLORED_SHADOWS=Bóng nắng xuyên kính màu
value.COLORED_SHADOWS.0=Tắt
value.COLORED_SHADOWS.1=Bật (chiếu màu RGB qua kính)

option.WATER_CAUSTICS=Vân nắng đáy nước & Khúc xạ
value.WATER_CAUSTICS.0=Tắt
value.WATER_CAUSTICS.1=Bật (gợn sóng + caustics)

option.LABPBR_SUPPORT=Tự động nhận Texture labPBR 1.3
value.LABPBR_SUPPORT.0=Tắt (chỉ IntegratedPBR)
value.LABPBR_SUPPORT.1=Bật (tự đọc _n & _s nếu có)

option.RT_STRENGTH=Cường độ Ray Tracing
option.shadowMapResolution=Độ phân giải bóng
value.shadowMapResolution.512=512 (Siêu nhẹ / FPS tối đa)
value.shadowMapResolution.1024=1024 (Nhanh / Khuyên dùng)
value.shadowMapResolution.2048=2048 (Cao)
value.shadowMapResolution.4096=4096 (Siêu nét)
option.FOG_STRENGTH=Độ mạnh sương mù
option.RAYS_STRENGTH=Độ mạnh tia nắng
option.DENSITY_SCALE=Mật độ không khí
option.SUN_SCATTER=Tán xạ về phía mặt trời
option.REFINE_THRESHOLD=Ngưỡng tinh chỉnh
option.REFINE_SOFTNESS=Độ mềm ngưỡng tinh chỉnh
